SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback
# Uncomment only to deliberately pin or replay a stale cache. Left unset,
# Kord tracks BTC_VERSION in backend/kord/engine.py, so an engine upgrade
# invalidates old analyses as intended — pinning it here silently defeats that.
# KORD_ENGINE_VERSION=btc-3
